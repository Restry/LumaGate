{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-ls27Lc1OytcVawXPVMplz6LyKz2i9KYAVBw3u79qyB4='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    },
    "windows": [
      {
        "center": true,
        "fullscreen": false,
        "height": 800,
        "label": "main",
        "minHeight": 600,
        "minWidth": 900,
        "resizable": true,
        "title": "\u67a2\u5149 \u00b7 LumaGate",
        "titleBarStyle": "Overlay",
        "visible": false,
        "width": 1200
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm run build:renderer",
    "beforeDevCommand": "pnpm run dev:renderer",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../src/manual/assets/GEIST-LICENSE.txt": "GEIST-LICENSE.txt"
    },
    "targets": "all",
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    }
  },
  "identifier": "cn.restry.lumagate",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Restry/LumaGate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5OUJBQTlERTRFRjVENzcKUldSM1hlL2tuYXFidVlQVDNZZ0NqZytJbjZuQUFkQ3FvN1pXWFJhZEhua2xnZmxqUUZvTEJ2eWMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "productName": "LumaGate",
  "version": "3.24.7"
}
